# Environment variables read by the application.
# The code reads them from the process environment; it does NOT load a .env file.
# Set them in your shell before running, for example in Windows Command Prompt:
#   set CANDIDATE_NAME=Your Name
# or in PowerShell:
#   $env:CANDIDATE_NAME = "Your Name"
# Never commit a real .env file (it is gitignored).

# Name used in cover-letter prompts and the sign-off. Default: [Candidate Name]
CANDIDATE_NAME=Your Name

# Path to YOUR career evidence catalog (JSON, same schema as career_evidence_schema.py).
# Default: 04_Application/career_evidence_catalog.json (gitignored)
# To try the tool with the fictional example:
#   CAREER_EVIDENCE_CATALOG=examples/synthetic_career_evidence_catalog.json
CAREER_EVIDENCE_CATALOG=

# Path to your job-application tracker workbook.
# Default: data/job_application_tracker.xlsx (gitignored)
# Create a blank one with:  python 04_Application/tracker_template.py data/job_application_tracker.xlsx
CAREER_TRACKER_PATH=

# Local model settings (LM Studio, http://127.0.0.1:1234)
JOB_ANALYSIS_MODEL=openai/gpt-oss-20b
JOB_ANALYSIS_REASONING_EFFORT=medium
JOB_ANALYSIS_TIMEOUT_SECONDS=600
JOB_EXTRACTION_MODEL=openai/gpt-oss-20b
JOB_EXTRACTION_TIMEOUT_SECONDS=300

# Only for the two manual live retrieval scripts (job_page_*_test.py):
# a public JobStreet job page you are allowed to fetch.
JOBSTREET_TEST_URL=
